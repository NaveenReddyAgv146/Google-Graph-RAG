# Environment configuration template for Ingestion Copilot
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=xenon-broker-513704-s9
GOOGLE_CLOUD_REGION=asia-south1
GOOGLE_CLOUD_LOCATION=asia-south1

# Cloud Spanner Graph
SPANNER_INSTANCE_ID=sales-discovery-trial
SPANNER_DATABASE_ID=sales-knowledge-db
SPANNER_GRAPH_NAME=EnterpriseKnowledgeGraph

# Cloud Storage
GCS_LEGACY_BUCKET=sales-discovery-mvp
GCS_MUMBAI_BUCKET=sales-discovery-mvp-mumbai

# Pub/Sub Ingestion Trigger & Reconciliation
INGESTION_PUBSUB_TOPIC=projects/xenon-broker-513704-s9/topics/ingestion-events
INGESTION_PUBSUB_SUB=projects/xenon-broker-513704-s9/subscriptions/ingestion-worker-sub

# Identity-Aware Proxy (IAP) Authentication
# Audience format: /projects/{PROJECT_NUMBER}/global/backendServices/{BACKEND_SERVICE_ID}
# For project xenon-broker-513704-s9 (project number 291679685305), supply the provisioned Load Balancer backend service ID:
IAP_AUDIENCE=/projects/291679685305/global/backendServices/<BACKEND_SERVICE_ID>

# Local Testing Authentication (Set to 'false' in all cloud deployment environments)
ENABLE_LOCAL_TEST_AUTH=false

# Models
REASONING_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSIONS=768

# Document AI Layout Parser (us region)
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=d79bb791cfba8a30
DOCUMENTAI_ENDPOINT=us-documentai.googleapis.com

# Server configuration
PORT=8080
